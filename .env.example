# Optional. Without a key, chat returns explicitly labeled source excerpts, not AI answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional vision-capable model for sampled video frames (defaults to selected chat model).
# VIDEO_VISION_MODEL=gpt-4.1-mini
PORT=3000
# DATA_DIR=./data

# Enterprise LLM Farm (OpenAI-compatible JSON responses).
# Set AI_PROVIDER=llm-farm to select this instead of OpenAI.
# AI_PROVIDER=llm-farm
# MODEL_FARM_API_KEY=
# BMF_API_KEY= # Alternative name; MODEL_FARM_API_KEY takes precedence.
# LLM_FARM_API_KEY= # Alternative name for an existing local key.
# LLM_FARM_AUTH=bearer
# Use subscription-key instead only if your Welcome Email requires the custom header.
# AI_CHAT_URL=https://aoai-farm.bosch-temp.com/api/openai/deployments/gpt-5-nano-2025-08-07/chat/completions?api-version=2025-04-01-preview
# AI_MODEL=gpt-5-nano-2025-08-07
# AI_TRANSCRIPTION_URL=https://aoai-farm.bosch-temp.com/<documented-transcription-route-and-query>
# AI_TRANSCRIPTION_MODEL=whisper-1

# Use Gemini 3.7 Flash for chat, audio transcription and sampled video frames:
# AI_CHAT_URL=https://aoai-farm.bosch-temp.com/api/openai/deployments/gemini-3.7-flash/chat/completions?api-version=2025-04-01-preview
# AI_MODEL=gemini-3.7-flash
# AI_TRANSCRIPTION_MODE=gemini
# Leave VIDEO_VISION_MODEL unset so all tasks use AI_MODEL.
# No AI_TRANSCRIPTION_URL is needed in Gemini mode.

# Local SpeechBrain embeddings and optional confirmed cross-recording voice memory (requires npm run voices:setup).
# VOICE_FINGERPRINTS=speechbrain
# VOICE_FINGERPRINT_PYTHON=/absolute/path/to/.venv-voices/bin/python
# VOICE_FINGERPRINT_MODEL_DIR=/absolute/path/to/model-cache
# Similarities are heuristic scores, not identity probabilities.
# VOICE_FINGERPRINT_THRESHOLD=0.75
# VOICE_FINGERPRINT_NEW_THRESHOLD=0.45
# VOICE_FINGERPRINT_MARGIN=0.08

# Parallel Dreaming text batches sent to the AI provider (1-16, default 4).
# DREAMING_CONCURRENCY=4

# Conversation (episodic) memory: on by default when an AI provider is configured.
# CHAT_MEMORY=off

# Semantic search: hybrid keyword + meaning retrieval through the AI provider's embeddings endpoint.
# OpenAI uses https://api.openai.com/v1/embeddings with text-embedding-3-small automatically.
# LLM Farm needs the embeddings deployment URL (the deployment name is used as the model label):
# AI_EMBEDDING_URL=https://aoai-farm.bosch-temp.com/api/openai/deployments/askbosch-prod-farm-openai-text-embedding-3-small/embeddings?api-version=2024-02-01
# AI_EMBEDDING_MODEL=text-embedding-3-small
# Minimum cosine similarity for a meaning-only match (0-1, default 0.4; built-in sections need +0.05).
# SEMANTIC_MIN_SIMILARITY=0.4
# SEMANTIC_SEARCH=off
